<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- La seule permission nécessaire. Tout accès au stockage passe par le sélecteur
         de dossier du système, qui accorde un droit sur ce que l'utilisateur a désigné
         et rien d'autre : réclamer « l'accès à tous les fichiers » n'apporterait aucune
         capacité de plus, seulement une demande alarmante à l'installation. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="Moonshop"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.MonShopApp"
        tools:ignore="UnusedAttribute"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Moonshop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
